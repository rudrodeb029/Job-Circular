<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/native_ad_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_native_ad_card"
        android:elevation="6dp"
        android:padding="12dp"
        android:layout_margin="10dp">

        <!-- Header: Ad Badge, Advertiser, Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/ad_close_btn">

                <TextView
                    android:id="@+id/ad_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="বিজ্ঞাপন • Ad"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#1D4ED8"
                    android:background="@drawable/bg_native_ad_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/ad_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Google Partner" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ad_close_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@drawable/ic_ad_close"
                android:contentDescription="Close Ad"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Media View (Hidden by default, shown if image/video exists) -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Main Content: Icon + Headline + Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="Ad Icon"
                tools:src="@drawable/app_logo_splash" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Example Sponsored Headline" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textColor="#475569"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"
                    tools:text="Discover related exam preparation materials and career notifications here." />
            </LinearLayout>
        </LinearLayout>

        <!-- Call to Action Button -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_native_ad_cta"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:stateListAnimator="@null"
            tools:text="Learn More" />

    </LinearLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
