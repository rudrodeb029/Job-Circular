rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Circulars & Content: Public read, authenticated/managed write
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    match /admits/{admitId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    match /activities/{actId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /liveExams/{examId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data != null;
    }
    
    // User Profiles: Public/user managed
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default Fallback Safety Catch: Allow read for app features, deny random root writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
