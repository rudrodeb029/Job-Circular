rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email != null
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Circulars & Content: Public read for app users, secure admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /admits/{admitId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /activities/{actId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    match /liveExams/{examId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    // User Profiles: Secure owner profile management & self registration
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || request.auth == null;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default Fallback Safety Catch: Allow read for app features, strictly deny unhandled root writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
